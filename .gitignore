node_modules/
web/dist/
# Downloaded/generated at build time (NASA textures, hourly cloud maps)
web/public/textures/
web/public/clouds/
web/public/satellites/
web/public/launches/
web/public/storms/
web/public/fires/
web/public/snowice/
web/public/lightning/
web/public/events/
web/public/smoke/
web/public/tsunami/
*.part
__pycache__/
*.egg-info/
.pytest_cache/
# Android build settings (the data host); see web/.env.android.example
web/.env.android
# Android TWA (Bubblewrap): twa-manifest.json is the project; the generated Gradle project,
# builds and the signing key stay local. Never commit a keystore.
web/android-twa/*
!web/android-twa/twa-manifest.json
*.keystore
*.jks
