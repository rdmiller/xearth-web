# Copy to .env.android and point at the server hosting the pipeline's data (GitHub Pages,
# or the Docker stack). The Android app bundles only the site; every layer's folder and the
# NASA textures are fetched from here, so the server must send CORS headers (GitHub Pages
# and the bundled nginx config both do). Trailing slash required.
VITE_DATA_BASE=https://your-host.example/
