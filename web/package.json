{
  "name": "xearth-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "A live space view of Earth, lit by the real Sun, with hourly clouds — xearth for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "textures": "node scripts/fetch-textures.mjs",
    "clouds": "cd ../pipeline && python -m xearth_clouds --out ../web/public/clouds"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
