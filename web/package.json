{
  "name": "xearth-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "A live space view of Earth, lit by the real Sun, with hourly clouds — xearth for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "textures": "node scripts/fetch-textures.mjs",
    "clouds": "cd ../pipeline && python -m xearth_clouds --out ../web/public/clouds",
    "satellites": "cd ../pipeline && python -m xearth_clouds.satellites --out ../web/public/satellites",
    "launches": "cd ../pipeline && python -m xearth_clouds.launches --out ../web/public/launches",
    "storms": "cd ../pipeline && python -m xearth_clouds.storms --out ../web/public/storms",
    "fires": "cd ../pipeline && python -m xearth_clouds.fires --out ../web/public/fires",
    "lightning": "cd ../pipeline && python -m xearth_clouds.lightning --out ../web/public/lightning",
    "events": "cd ../pipeline && python -m xearth_clouds.events --out ../web/public/events",
    "snowice": "cd ../pipeline && python -m xearth_clouds.snowice --out ../web/public/snowice",
    "smoke": "cd ../pipeline && python -m xearth_clouds.smoke --out ../web/public/smoke",
    "tsunami": "cd ../pipeline && python -m xearth_clouds.tsunami --out ../web/public/tsunami",
    "ionosphere": "cd ../pipeline && python -m xearth_clouds.ionosphere --out ../web/public/ionosphere",
    "icons": "python scripts/make-icons.py",
    "android:build": "vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "twa:manifest": "node scripts/twa.mjs manifest",
    "twa:assetlinks": "node scripts/twa.mjs assetlinks"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "lightstreamer-client-web": "^9.2.3",
    "lucide": "^1.60.0",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
