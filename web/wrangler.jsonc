// Cloudflare Workers, static assets only: the built site (pnpm build → dist), served as is.
// The deploy workflow runs `wrangler deploy` here after each build; headers come from
// public/_headers. Without a route, it's served at https://xearth-web.<subdomain>.workers.dev.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "xearth-web",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  // Workers logs and traces, every request, kept (the dashboard's Observability tab).
  // Set here, since each deploy applies this file over the dashboard's settings.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
